# ------------------------------------------------------------------------------
# Khusi Kirana - Backend API Environment Variables Example
# Copy this file to 'backend/.env' in your local environment.
# ------------------------------------------------------------------------------

PORT=5001
NODE_ENV=development

# MongoDB Connection String (Atlas or Local)
# Production Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database_name>?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/khushi

# Authentication Tokens Signature
JWT_SECRET=your_jwt_super_secret_signing_key_here

# Payment Gateway Configurations (Razorpay API)
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

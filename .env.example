# ------------------------------------------------------------------------------
# Khusi Kirana - Root Environment Variables Example
# Copy this file to '.env' in your local environment and configure your values.
# ------------------------------------------------------------------------------

# App Mode & Port Configuration
PORT=5001
NODE_ENV=development

# Database Connection (MongoDB Atlas for Production / Local MongoDB for Dev)
# Production Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database_name>?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/khushi

# JSON Web Token Secret (used for securing auth endpoints)
# Use a highly secure, long random string in production
JWT_SECRET=your_jwt_super_secret_signing_key_here

# Payment Gateway Keys (Razorpay)
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# Frontend Variables (Passed during Vite build phase)
VITE_RAZORPAY_KEY_ID=your_razorpay_key_id_here
VITE_API_URL=http://localhost:5001/api
